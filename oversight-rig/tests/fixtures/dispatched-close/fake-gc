#!/usr/bin/env python3
# Fake gc for oversight-rig/tests/test_dispatched_close_watch.py. Reads fixtures from $FAKE_DIR, logs every call to
# calls.jsonl, and emulates `gc mail send --dedup`: a key already delivered is suppressed (exit 0).
#   events ...            -> events.jsonl       rig list --json -> rigs.json
#   bd show <id> --json   -> bead-<id>.json     session list --json -> sessions.json
#   mail send ...         -> delivered.jsonl
# A file named FAIL-<subcommand> (FAIL-events, FAIL-bd, FAIL-mail...) makes that subcommand exit 1.
import json, os, sys
a = sys.argv[1:]
d = os.environ["FAKE_DIR"]
with open(os.path.join(d, "calls.jsonl"), "a") as f:
    f.write(json.dumps(["gc"] + a) + "\n")
if os.path.exists(os.path.join(d, "FAIL-" + a[0])):
    sys.stderr.write("fake gc: %s unavailable\n" % a[0])
    sys.exit(1)


def fixture(name, default=None):
    p = os.path.join(d, name)
    if not os.path.exists(p):
        return default
    return open(p).read()


if a[0] == "events":
    sys.stdout.write(fixture("events.jsonl", ""))
elif a[:2] == ["rig", "list"]:
    sys.stdout.write(fixture("rigs.json"))
elif a[:2] == ["bd", "show"]:
    text = fixture("bead-%s.json" % a[2])
    if text is None:
        sys.stderr.write("Error: no issue found matching %r\n" % a[2])
        sys.exit(1)
    sys.stderr.write('gc bd: answering from the rig store\n')
    sys.stdout.write(text)
elif a[:2] == ["session", "list"]:
    sys.stdout.write(fixture("sessions.json", '{"sessions": []}'))
elif a[:2] == ["mail", "send"]:
    key = a[a.index("--dedup") + 1] if "--dedup" in a else None
    log = os.path.join(d, "delivered.jsonl")
    sent = [json.loads(l) for l in open(log)] if os.path.exists(log) else []
    if key and any(m["dedup"] == key for m in sent):
        sys.exit(0)
    with open(log, "a") as f:
        f.write(json.dumps({"to": a[2], "dedup": key, "args": a}) + "\n")
else:
    sys.stderr.write("fake gc: unexpected call %r\n" % a)
    sys.exit(3)
